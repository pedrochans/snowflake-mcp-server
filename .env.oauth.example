# Snowflake Connection Parameters - OAuth (local application) Example
#
# Uses Snowflake's built-in SNOWFLAKE$LOCAL_APPLICATION OAuth integration:
# a browser window opens only on the first login. The access and refresh
# tokens are then kept in the OS credential store (macOS Keychain, Windows
# Credential Manager, libsecret) and renewed silently, so restarts and
# reconnects do not reopen the browser until the refresh token expires.

# Authentication Type
SNOWFLAKE_AUTH_TYPE=oauth

# Connection Parameters
SNOWFLAKE_ACCOUNT='ORG-ACCOUNT'
# IMPORTANT: with OAuth this must be your Snowflake user NAME, which is NOT
# necessarily your LOGIN_NAME (the email used for external-browser SSO).
# Find it with   SELECT CURRENT_USER();   or   DESC USER <you>;  -> NAME row.
SNOWFLAKE_USER='USER_NAME'
SNOWFLAKE_WAREHOUSE='USER_WH'
SNOWFLAKE_DATABASE='DATABASE'
SNOWFLAKE_SCHEMA='SCHEMA'
SNOWFLAKE_ROLE='R_ROLE'
